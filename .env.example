# Anthropic (optional — Claude Code subscription is used by default, not API credits)
ANTHROPIC_API_KEY=

# Feishu App credentials (from Feishu Open Platform)
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Bot's own open_id (find via lark-cli contact +me --as bot)
LARK_BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin user's open_id (daily digest recipient)
MY_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
